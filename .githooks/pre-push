# =====================================================================
# SOLO CORREN LOS CONTROLES QUE MIRAN LO QUE CAMBIO.      20/11/2026
# =====================================================================
# Dicho por el usuario, textual: "SI YO TE DIGO PROBA TODO SI, SINO
# MODIFICA, PROBA Y QUE SEA LA PRUEBA SOBRE LO QUE SE CAMBIO... NO QUE
# CONTROLE DE NUEVO TODO".
# Tenia razon y le costo una hora de espera: cuatro intentos de push por
# un cambio de DISEÑO, y en cada uno se revisaron las Edge Functions, la
# lectura de los PDF de proveedores y el dictado por voz, que no se
# habian tocado. Peor: el ultimo corto por el control del dictado, que
# se tropezo por correr vigesimo con el navegador saturado.
#
# Cada puerta declara QUE MIRA. Si el push no toca nada de eso, no corre
# — y se DECLARA que no corrio, con el motivo. Una puerta salteada no es
# una puerta verde: es una puerta que no se ejercito, y eso se dice.
#
#   git push                 -> solo lo que toca
#   CONTROL_TODO=1 git push  -> las veinte, como antes
# =====================================================================

# que archivos trae este push, contra lo que ya esta publicado
CAMBIADOS="$(git diff --name-only origin/main...HEAD 2>/dev/null || git diff --name-only HEAD~1 HEAD 2>/dev/null || echo '')"

# nombre de la puerta -> expresion de los caminos que mira.
# "SIEMPRE" = corre en todos los push: miden el push en si, no el codigo.
que_mira(){
  case "$1" in
    "el acceso"|"lo publicado") echo "SIEMPRE" ;;
    "el control del control de lo publicado") echo "control/publicado" ;;
    "el alcance")               echo "js/core[.]js|[.]html$|control/alcance|control/supabase-de-juguete" ;;
    "el control del control del alcance") echo "control/alcance" ;;
    "las edge functions")       echo "^edge/|control/edge[.]js" ;;
    "los rotulos")              echo "[.]html$|^js/|control/rotulo" ;;
    "las cifras publicadas")    echo "^js/|control/cifra" ;;
    "el control del control del archivo") echo "control/archivo" ;;
    "el control del control del pdf")     echo "control/pdf|js/bajar" ;;
    "las pantallas")            echo "[.]html$|^js/|^css/|control/pantallas|control/supabase-de-juguete" ;;
    "el archivo bajado")        echo "[.]html$|^js/|^css/|control/archivo|control/supabase-de-juguete" ;;
    "el camino del usuario")    echo "[.]html$|js/core[.]js|control/menu|control/supabase-de-juguete" ;;
    "las clases sin estilo")    echo "[.]html$|^js/|^css/|control/estilos" ;;
    "el aviso en vivo")         echo "js/core[.]js|control/envivo" ;;
    "las firmas")               echo "^js/|control/firmas|control/supabase-de-juguete" ;;
    "los pasos en vivo")        echo "js/ayuda|^edge/|control/vivo" ;;
    "el dictado")               echo "js/ayuda|control/voz" ;;
    "la lectura de listas")     echo "js/listas|^edge/listas|control/listas" ;;
    "la pantalla vacia")        echo "[.]html$|^js/|control/vacio|control/supabase-de-juguete" ;;
    "los rotulos en pantalla")  echo "[.]html$|^js/|^css/|control/rotulos-todos|control/supabase-de-juguete" ;;
    "las variables de css")     echo "^css/|control/css-variables" ;;
    "el ipc")                   echo "SIEMPRE" ;;
    # SIEMPRE a proposito: esta puerta mide la FUNCION de la base, que no vive
    # en el repositorio. No hay archivo que cambie cuando cambia lo que mide,
    # asi que declarar un patron seria declarar que no la corre nunca.
    "que las partes sumen")     echo "SIEMPRE" ;;
    *)                          echo "SIEMPRE" ;;   # una puerta nueva corre hasta que declare que mira
  esac
}

# correr <archivo> <comando...>  — si el archivo no esta, se corta:
# NO MEDIDO NO ES LIMPIO.
correr(){
  local nombre="$1"; shift
  local archivo="$1"; shift

  # ¿esta puerta mira algo de lo que cambio?
  if [ "${CONTROL_TODO:-}" != "1" ]; then
    local mira; mira="$(que_mira "$nombre")"
    if [ "$mira" != "SIEMPRE" ]; then
      if ! echo "$CAMBIADOS" | grep -qE "$mira"; then
        SALTEADAS="$SALTEADAS|$nombre"
        return
      fi
    fi
  fi

  if [ ! -f "$archivo" ]; then
    echo "pre-push: no esta $archivo. No se controla nada: se corta."
    FALLARON="$FALLARON $nombre(falta)"
    # Una puerta que falta se anota igual, y se anota como FALLADA: si no,
    # api_estado_del_sistema la mostraria con la medicion de ayer, que es
    # la mentira que este registro existe para que no pueda pasar.
    node control/anotar.js "$nombre" 0 "no esta $archivo" \
         "la puerta no existe en esta copia del repositorio" 2>/dev/null
    return
  fi
  echo ""
  echo "── pre-push: $nombre ──"
  # LA SALIDA SE GUARDA Y SE MUESTRA. Se guarda para poder anotar en la base
  # QUE midio esta corrida —la linea "midio:" de cada control— y se muestra
  # porque el que corre el push tiene que leerla. `tee` hace las dos cosas;
  # el codigo de salida sale de PIPESTATUS, no de tee, que siempre da 0.
  local log; log="$(mktemp)"
  "$@" 2>&1 | tee "$log"
  local salio="${PIPESTATUS[0]}"
  local midio resumen
  midio="$(grep -m1 -E '^[[:space:]]*(midio|adentro de los archivos midio):' "$log" | head -c 600)"
  resumen="$(grep -m1 -E '(0 fallas|falla\(s\)|de [0-9]+\.|SE CORTA|NO PUDO)' "$log" | head -c 600)"
  if [ "$salio" -eq 0 ]; then
    PASARON="$PASARON $nombre"
    node control/anotar.js "$nombre" 1 "$midio" "$resumen" 2>/dev/null
  else
    FALLARON="$FALLARON $nombre"
    node control/anotar.js "$nombre" 0 "$midio" "$resumen" 2>/dev/null
  fi
  rm -f "$log"
}

