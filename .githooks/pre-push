#!/usr/bin/env bash
# =====================================================================
# LA PUERTA. NO SALE UN PUSH QUE NO PASE LOS CONTROLES.
# =====================================================================
# 28/10  nacio con un solo control: NO SE SUBE UNA PANTALLA QUE NO SE VE.
#        Existia porque una regla escrita en las notas no frena nada: ese
#        dia subi una pantalla con texto de 1,09 a 1 de contraste y mis
#        controles no lo agarraron porque median errores y scroll, no SI
#        SE VE.
# 31/10  SE DESCUBRIO QUE ESTE HOOK NUNCA HABIA CORRIDO. `core.hooksPath`
#        es configuracion local del clon, no se versiona, y el contenedor
#        se rehace cada sesion: la puerta se desenchufaba sola todos los
#        dias. Ahora control/pantallas.js se enchufa solo al correr.
# 01/11  se le sumaron los otros dos controles.
#
# Se prende una sola vez por copia del repositorio (y si se olvida, el
# control de pantallas lo hace solo la primera vez que corre):
#     git config core.hooksPath .githooks
#
# Si alguna vez hay que subir con un control en rojo (una urgencia real),
# es con `git push --no-verify`, a conciencia y diciendolo.
#
# Tarda unos cinco minutos. Tardar es barato: entregar algo que no vi
# funcionar cuesta el dia, la confianza y la cara delante de DISSAN.
# =====================================================================
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

FALLARON=""
PASARON=""

# correr <archivo> <comando...>  — si el archivo no esta, se corta:
# NO MEDIDO NO ES LIMPIO.
correr(){
  local nombre="$1"; shift
  local archivo="$1"; shift
  if [ ! -f "$archivo" ]; then
    echo "pre-push: no esta $archivo. No se controla nada: se corta."
    FALLARON="$FALLARON $nombre(falta)"
    # Una puerta que falta se anota igual, y se anota como FALLADA: si no,
    # api_estado_del_sistema la mostraria con la medicion de ayer, que es
    # la mentira que este registro existe para que no pueda pasar.
    node control/anotar.js "$nombre" 0 "no esta $archivo" \
         "la puerta no existe en esta copia del repositorio" 2>/dev/null
    return
  fi
  echo ""
  echo "── pre-push: $nombre ──"
  # LA SALIDA SE GUARDA Y SE MUESTRA. Se guarda para poder anotar en la base
  # QUE midio esta corrida —la linea "midio:" de cada control— y se muestra
  # porque el que corre el push tiene que leerla. `tee` hace las dos cosas;
  # el codigo de salida sale de PIPESTATUS, no de tee, que siempre da 0.
  local log; log="$(mktemp)"
  "$@" 2>&1 | tee "$log"
  local salio="${PIPESTATUS[0]}"
  local midio resumen
  midio="$(grep -m1 -E '^[[:space:]]*(midio|adentro de los archivos midio):' "$log" | head -c 600)"
  resumen="$(grep -m1 -E '(0 fallas|falla\(s\)|de [0-9]+\.|SE CORTA|NO PUDO)' "$log" | head -c 600)"
  if [ "$salio" -eq 0 ]; then
    PASARON="$PASARON $nombre"
    node control/anotar.js "$nombre" 1 "$midio" "$resumen" 2>/dev/null
  else
    FALLARON="$FALLARON $nombre"
    node control/anotar.js "$nombre" 0 "$midio" "$resumen" 2>/dev/null
  fi
  rm -f "$log"
}

# EL ACCESO VA PRIMERO, Y NO ES UN DETALLE DE ORDEN.          01/11/2026
# Hoy le dije al usuario que no podia entrar al panel —cuando el 31/10 habia
# entrado— y le pedi que confirmara cosas en el navegador por su cuenta. Le
# hice perder una hora. Fue una afirmacion sobre lo que yo puedo hacer, sacada
# de la memoria, sin medirla: la misma clase que publicar una cifra sin
# verificarla. Esta puerta exige que la medicion exista y sea de esta sesion.
# Primera, porque si no se sabe QUE se puede probar, lo que digan las otras
# cinco no se puede interpretar.
correr "el acceso"          control/acceso.js     node control/acceso.js

correr "las edge functions" control/edge.js       node control/edge.js
correr "los rotulos"        control/rotulo.js     node control/rotulo.js
correr "las cifras publicadas" control/cifra.js   node control/cifra.js
correr "el control del control del archivo" control/archivo-senuelos.py \
                                                  python3 control/archivo-senuelos.py
# El PDF tiene su propio control del control: son otras ocho clases, y hasta el
# 01/11 el PDF no lo medía NADIE — la puerta cerraba diciendo "NO midio: el PDF".
correr "el control del control del pdf" control/pdf-senuelos.js \
                                                  node control/pdf-senuelos.js
correr "las pantallas"      control/pantallas.js  node control/pantallas.js
correr "el archivo bajado"  control/archivo.js    node control/archivo.js

echo ""
if [ -z "$FALLARON" ]; then
  echo "pre-push: pasan todos ($PASARON ). Sube."
  exit 0
fi

echo "pre-push: EL PUSH SE CORTA. Fallaron:$FALLARON"
[ -n "$PASARON" ] && echo "          Pasaron:$PASARON"
echo "          Arreglá lo de arriba y volvé a intentar."
echo "          (si de verdad hay que subir igual: git push --no-verify)"
exit 1
